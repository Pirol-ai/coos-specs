{
  "id": "maintenance",
  "name": "Maintenance",
  "seeds": {
    "processes": [
      {
        "slug": "perform-machine-service",
        "runBy": "Responsible person",
        "steps": [
          {
            "type": "task",
            "title": "Align the service date with the responsible person"
          },
          {
            "type": "task",
            "title": "Take the machine out of operation and secure it"
          },
          {
            "type": "task",
            "title": "Perform the service per manufacturer spec and note findings"
          },
          {
            "type": "task",
            "title": "Put the machine back into operation and verify function"
          },
          {
            "type": "task",
            "title": "Record the service date on the machine and set the next due date"
          }
        ],
        "title": "Perform machine service",
        "cadence": "Per service interval",
        "category": "Operations",
        "description": "Standard flow of a planned machine service."
      }
    ]
  },
  "tools": [
    {
      "op": "query",
      "name": "machines_query",
      "over": "ext_maintenance_machines",
      "effect": "read-only"
    },
    {
      "op": "insert",
      "name": "machines_service_update",
      "over": "ext_maintenance_machines",
      "effect": "consequential"
    }
  ],
  "views": [
