          "ext_maintenance.machines.responsible",
          "ext_maintenance.machines.last_service",
          "ext_maintenance.machines.next_service",
          "ext_maintenance.machines.status"
        ],
        "groupBy": []
      },
      "title": "Machines",
      "hidden": false,
